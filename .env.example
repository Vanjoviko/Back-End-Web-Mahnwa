# Worker scan-import -- salin ke .env.dev (dev) atau .env.prod (produksi).
# `python -m app` memuat .env.<APP_ENV> otomatis; variabel yang sudah ada di shell menang.
# JANGAN commit file env asli (.env, .env.dev, .env.prod) -- hanya contoh ini yang di-commit.

# Lingkungan aktif: dev | prod. Menentukan file env yang dimuat & perilaku aman.
APP_ENV=dev

# --- Database (PostgreSQL + Alembic) --------------------------------------
# Dipakai bersama Docker Compose. Port host 5433 menghindari Postgres lokal di 5432.
POSTGRES_USER=ganti-user-ini
POSTGRES_PASSWORD=ganti-password-ini
POSTGRES_DB=mahnwa
POSTGRES_PORT=5433
# URL untuk ORM/Alembic. Di dalam Compose host database = `db`; dari host = localhost.
DATABASE_URL=postgresql+psycopg://ganti-user-ini:ganti-password-ini@db:5432/mahnwa

# --- Keamanan -----------------------------------------------------------
# Wajib (kecuali SCAN_DEV_MODE=true). Harus sama dengan SCAN_WORKER_TOKEN di FE.
WORKER_TOKEN=ganti-token-ini
# Bind default hanya localhost. Di dalam container diisi 0.0.0.0 oleh compose.yaml.
WORKER_BIND=127.0.0.1
WORKER_PORT=8000
# Basis URL absolut untuk `url` pada manifest chapter. Kosong = path relatif.
PUBLIC_BASE_URL=
# Mode pengembangan lokal: mengizinkan http:// dan host loopback/privat. Jangan dipakai di produksi.
SCAN_DEV_MODE=false
# Swagger (/docs), ReDoc (/redoc), dan /openapi.json. Default nyala. Set false untuk menutup peta endpoint.
SCAN_ENABLE_DOCS=true

# --- Sumber ---------------------------------------------------------------
# Tidak ada daftar host yang diizinkan: sumber publik apa pun boleh di-scan/diunduh
# (SSRF guard menolak IP privat/lokal). Hanya ambil konten yang pemiliknya mengizinkan.
# Adapter fixture lokal (hanya bersama SCAN_DEV_MODE=true).
SCAN_ENABLE_FIXTURE=false
SCAN_FIXTURE_DIR=./fixtures
SCAN_USER_AGENT=AkumaScan/1.0
SCAN_CONTACT=

# --- Penyimpanan ----------------------------------------------------------
STAGING_DIR=./staging
SCAN_STAGING_TTL_HOURS=24
SCAN_MIN_FREE_DISK_BYTES=1073741824

# --- Limit jalur scan-import (NFR-01). "150 MB" = 150 MiB. ---------------
SCAN_MAX_PAGES_PER_CHAPTER=300
SCAN_MAX_BYTES_PER_CHAPTER=157286400
SCAN_MAX_BYTES_PER_IMAGE=15728640
SCAN_MAX_COVER_BYTES=5000000
SCAN_MAX_MANIFEST_BYTES=5000000

# --- Konversi WebP halaman (opsional) ------------------------------------
# Saat aktif, setiap halaman yang diunduh dienkode ulang ke WebP (JPEG/PNG/WebP -> WebP).
# `bytes`/`sha256` manifest memakai hasil konversi, jadi integritas FE tetap valid.
# Format asli dipertahankan bila WebP tidak lebih kecil (mis. halaman rusak/aneh).
SCAN_CONVERT_WEBP=true
SCAN_WEBP_QUALITY=80

# --- Konkurensi, jeda, retry, timeout -------------------------------------
SCAN_CHAPTER_CONCURRENCY=2
SCAN_IMAGE_CONCURRENCY=4
SCAN_HOST_MAX_CONCURRENCY=4
SCAN_HOST_MIN_DELAY_MS=500
SCAN_MAX_ACTIVE_JOBS=2
SCAN_IMAGE_RETRIES=2
SCAN_RETRY_BACKOFF_BASE_S=1
SCAN_RETRY_AFTER_CAP_S=60
SCAN_TIMEOUT_S=90
SCAN_HTML_TIMEOUT_S=30
SCAN_IMAGE_TIMEOUT_S=60
SCAN_CONNECT_TIMEOUT_S=10

# --- Kode legacy (Q8) ------------------------------------------------------
# /api/manga/*, /api/chapters/*, ScraperService lama. Default MATI. Tanpa autentikasi & tanpa SSRF guard.
ENABLE_LEGACY_API=false

# --- Login sosial (OAuth) --------------------------------------------------
# Rahasia HANYA di env backend; jangan pernah dikirim ke browser / di-commit.
# Nilai kosong = tombol penyedia mati (AUTH_ENABLED tetap bisa true untuk provider lain).
AUTH_ENABLED=false
# Basis URL front-end (BFF) & backend (callback OAuth).
AUTH_FRONTEND_BASE_URL=https://ganti-domain-frontend
AUTH_PUBLIC_BASE_URL=https://ganti-domain-backend
# Kunci HMAC untuk cookie transaksi OAuth (state + PKCE). WAJIB di produksi.
AUTH_SECRET=
# Sesi: cookie HttpOnly + SameSite=Lax; Secure wajib true di produksi.
AUTH_SESSION_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
# Google (cakupan: openid email profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord (cakupan: identify email)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# X (cakupan baca profil paling kecil)
X_CLIENT_ID=
X_CLIENT_SECRET=
# RBAC: daftar email master admin (dipisah koma). Email terverifikasi ini berperan 'admin' saat login.
ADMIN_EMAILS=
